# Todas las variables que la app lee (tests/env-documentado.test.ts lo verifica).

# URL de la base SQLite usada por Prisma (ruta relativa a la raíz del proyecto).
# En docker-compose se fija a file:/data/sifap.db (volumen `sifap-data`); este valor no se usa allí.
DATABASE_URL="file:./dev.db"

# Usuario operativo registrado en la auditoría para acciones de la UI (máx. 8 caracteres).
SIFAP_USER="SIFAPUSR"

# LEGACY-QUIRK(D4): bypass de validación de documentos por prefijo de CPF.
# Mantener en false salvo aprobación de negocio/seguridad.
LEGACY_DOC_ESPECIAL_ENABLED=false

# LEGACY-QUIRK(D18): CADBENEF grababa el status en blanco al alterar un beneficiario.
# false (default) = sigue el PRD (status editable); true = réplica del legado.
LEGACY_STATUS_BRANCO_ALTERACAO_ENABLED=false

# Correcciones de LEGACY-QUIRK (docs/prd.md §5). Vacío = paridad total con el legado.
# Lista separada por comas de: D4b,D5,D6,D7,D8,D9,D10,D11,D12,D13,D16,D17,D19,D20,D21,D22,D23
# o ALL (ALL no incluye D7: requiere aprobación de auditoría, listarlo explícito: "ALL,D7"). Ej.: SIFAP_QUIRKS_CORRIGIDOS="D17,D21,D23"
SIFAP_QUIRKS_CORRIGIDOS=

# Expiración (minutos) de los candados entre procesos del lote y de la conciliación
# (tabla ProcessoLock). Un candado más viejo se considera huérfano (proceso caído) y
# se reemplaza. Debe superar la duración máxima de una corrida. Default 120.
SIFAP_LOCK_EXPIRACAO_MIN=120

# Zona horaria usada por hoje() para fechas legadas AAAAMMDD.
# En la imagen Docker/compose se fija a America/Sao_Paulo.
TZ=America/Sao_Paulo

# --- Solo docker-compose / imagen (no los lee la app) ---
# Puerto del host mapeado al 3000 del contenedor (por defecto 3000).
SIFAP_PORT=3000
# Nombre del volumen de datos (por defecto sifap-data); cambiar solo para pruebas aisladas.
SIFAP_VOLUME=sifap-data
# docker-entrypoint.sh: 1 = no aplicar migraciones en ese contenedor. Se pasa por
# contenedor con -e (compose no lo reenvía desde .env), p. ej. `docker compose run --rm -e SKIP_MIGRATIONS=1 app npm run lote:pagamentos`).
SKIP_MIGRATIONS=0
