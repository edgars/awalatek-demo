# URL de la base SQLite usada por Prisma (ruta relativa a la raíz del proyecto).
# En docker-compose: file:/data/sifap.db
DATABASE_URL="file:./dev.db"

# Usuario operativo registrado en la auditoría para acciones de la UI (máx. 8 caracteres).
SIFAP_USER="SIFAPUSR"

# LEGACY-QUIRK(D4): bypass de validación de documentos por prefijo de CPF.
# Mantener en false salvo aprobación de negocio/seguridad.
LEGACY_DOC_ESPECIAL_ENABLED=false

# Zona horaria usada por hoje() para fechas legadas AAAAMMDD.
TZ=America/Sao_Paulo
